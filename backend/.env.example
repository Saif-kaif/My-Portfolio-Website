# ---------------------------------------------------------------
# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.
# ---------------------------------------------------------------

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Public URL of the site (used for sitemap.xml and robots.txt)
SITE_URL=http://localhost:3000

# Set to 1 (number of proxy hops) or "true" when running behind a reverse proxy
# such as Nginx, Render, Railway or Heroku, so rate limiting sees real client IPs.
TRUST_PROXY=false

# PostgreSQL — either a single connection string...
# DATABASE_URL=postgres://portfolio_user:change-me@localhost:5432/portfolio

# ...or the standard libpq variables (read automatically by `pg`)
PGHOST=localhost
PGPORT=5432
PGDATABASE=portfolio
PGUSER=portfolio_user
PGPASSWORD=change-me

# Enable TLS for managed databases (true/false)
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=10

# Admin sessions (hours, 1–168)
SESSION_TTL_HOURS=8

# Rate limits (requests per 15 minutes per IP)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_LOGIN_MAX=10

# Optional: non-interactive admin creation for `npm run admin:create`
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
